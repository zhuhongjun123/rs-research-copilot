# ── LLM ─────────────────────────────────────────────────────────
# Provider 可插拔（见 src/rsrc/llm.py）；默认 DeepSeek（OpenAI 兼容接口）
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ── Zotero ──────────────────────────────────────────────────────
# 留空则自动从 Zotero 的 prefs.js 读取 dataDir（推荐）
# 本机实测数据目录不在默认 ~/Zotero，务必不要硬编码
ZOTERO_DATA_DIR=
# 本地 API 地址（需在 Zotero 设置中勾选「允许其它应用程序与 Zotero 通信」）
ZOTERO_LOCAL_API=http://localhost:23119/api

# ── 检索 ────────────────────────────────────────────────────────
EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
TOP_K=10
